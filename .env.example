# Optional configuration for MI Code builds. Leave these unset for local pairing.
# Configure public identifiers for your own Clerk and relay deployment.
# Keep server-side secrets outside this file.

# T3CODE_CLERK_PUBLISHABLE_KEY=pk_test_...
# T3CODE_CLERK_JWT_TEMPLATE=t3-relay
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=...
# T3CODE_RELAY_URL=https://relay.example.com
# T3CODE_HOSTED_APP_URL=https://micode.example.com

# Optional iOS signing and Expo OTA. OTA remains disabled unless explicitly enabled.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/your.provisionprofile
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=clerk.example.com
# T3CODE_EAS_PROJECT_ID=your-expo-project-id
# T3CODE_MOBILE_UPDATES_ENABLED=1

# Public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=t3-code-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
