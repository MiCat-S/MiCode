# Optional public origin for your own hosted client.
# T3CODE_HOSTED_APP_URL=https://micode.example.com

# Optional iOS signing and Expo OTA. OTA remains disabled unless explicitly enabled.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_EAS_PROJECT_ID=your-expo-project-id
# T3CODE_MOBILE_UPDATES_ENABLED=1

# Optional macOS in-app browser passkeys for domains you control.
# T3CODE_MACOS_PASSKEY_RP_DOMAINS=micode.example.com
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/your.provisionprofile
